{
  "name": "maestro-ui-tests",
  "private": true,
  "scripts": {
    "test": "npm run test:debug",
    "test:debug": "dotenv -e .env.debug -- maestro test .maestro --exclude-tags=android-default",
    "test:prod": "dotenv -e .env.prod -- maestro test .maestro --exclude-tags=android-default",
    "test:release": "npm run test:prod",
    "test:smoke": "npm run test:smoke:debug",
    "test:android:contacts": "dotenv -e .env.debug -- maestro test .maestro --include-tags=android-default"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
